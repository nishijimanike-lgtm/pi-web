{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pi-web",
  "version": "0.12.2",
  "identifier": "io.pi.web",
  "build": {
    "frontendDist": "http://127.0.0.1:30141",
    "devUrl": "http://127.0.0.1:30141",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pi Web",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
